# SmartAttend Environment Variables
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=development
SECRET_KEY=smartattend-dev-secret-change-in-production
DEBUG=True
PORT=5000

# Database Configuration
DATABASE_URL=sqlite:///smartattend.db
# For production PostgreSQL:
# DATABASE_URL=postgresql://username:password@localhost:5432/smartattend

# JWT Configuration
JWT_SECRET_KEY=jwt-secret-change-in-production

# Attendance Settings
ATTENDANCE_THRESHOLD=75.0
LATE_THRESHOLD_MINUTES=15
QR_TOKEN_EXPIRY_SECONDS=300
QR_SESSION_EXPIRY_MINUTES=60

# WhatsApp Configuration
WHATSAPP_MODE=mock  # Use 'cloud_api' for production with real WhatsApp
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v18.0
WHATSAPP_PHONE_NUMBER_ID=

# Face Recognition
FACE_RECOGNITION_TOLERANCE=0.6
FACE_ENROLLMENT_SAMPLES=5

# Notifications
NOTIFICATION_RETRY_ATTEMPTS=3
NOTIFICATION_RETRY_DELAY_SECONDS=60

# College Info
COLLEGE_NAME=SmartAttend College